# ==============================================================================
# Beauty Salon Booking System - Environment Configuration (.env.example)
# Copy this file to `.env` or `.env.local` and configure your local settings.
# Never commit real credentials or secrets to version control.
# ==============================================================================

# Application Environment & Port
NODE_ENV=development
PORT=3001

# Neon PostgreSQL Connection URL
# Use your development branch connection string from Neon dashboard.
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Administrator Authentication
# Generate a strong random key (e.g. `openssl rand -base64 32`)
JWT_SECRET="replace-with-a-secure-random-32-character-secret"

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# In development: http://localhost:3000 (Next.js default)
FRONTEND_URL="http://localhost:3000"

# (Optional) Initial Administrator Provisioning Credentials
# Can also be entered interactively via `npm run admin:provision`
ADMIN_EMAIL="admin@beautysalon.com"
ADMIN_PASSWORD="ChooseAStrongPassword123!"
